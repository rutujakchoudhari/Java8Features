package java8Task;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.List;

	public class IoDemo {
	    public static void main(String[] args) {
	        try {
	            List<String> lines = Files.readAllLines(Paths.get("example.txt"));
	            lines.forEach(System.out::println);
	        } catch (Exception e) {
	            e.printStackTrace();
	        }
	    }
	}

}
